{
  "name": "reelsavenow-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @reelsavenow/web dev",
    "dev:api": "pnpm --filter @reelsavenow/api dev",
    "dev:tunnel": "node scripts/dev-tunnel.cjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "axios": "^1.20.0"
    }
  }
}
