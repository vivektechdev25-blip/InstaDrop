# Local development defaults. Both values are inlined into the client bundle
# at build time, so they are public - never put a secret in a NEXT_PUBLIC_*
# variable.

# Where the browser sends /fetch, /private/fetch and /download. Include
# /api/v1; a trailing slash is stripped automatically.
# PRODUCTION: a production build FAILS if this is missing or points at
# localhost, rather than silently publishing a site whose downloads can never
# work (see docs/KNOWN_ISSUES.md). Set it in the deploy platform, not here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Canonical URLs, sitemap, robots and OG tags.
NEXT_PUBLIC_SITE_URL=https://reelsavenow.com
