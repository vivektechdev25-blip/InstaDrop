PORT=4000

# CORS: comma-separated EXACT origins (scheme://host[:port], lowercase, no
# trailing slash). Validated at startup - a value that could never match a
# browser Origin header stops the boot. Production: the Netlify origin(s).
CORS_ORIGIN=http://localhost:3000

# Supabase request logging is scaffolded but NOT wired in (docs/DATABASE.md).
# Nothing reads these at runtime today; leave them unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
